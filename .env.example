# ============== 通用配置 ==========================


# Excel 数据文件路径
EXCEL_FILE=./data/用例.xlsx

# 提取 ID 的前缀
VAR_NAME=ID

# JWT 密钥（Flask 专用）
SECRET_KEY=
JWT_EXPIRE=7200


# ============== Flask 项目配置 ====================

# Flask 服务地址
BASE_URL=http://127.0.0.1:5000
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# Flask 登录账号
LOGIN_USER=admin
LOGIN_PASSWORD=

# Flask 数据库配置
FLASK_DB_HOST=127.0.0.1
FLASK_DB_PORT=3306
FLASK_DB_NAME=task_system
FLASK_DB_USER=root
FLASK_DB_PASSWORD=
FLASK_DB_CHARSET=utf8mb4

# Flask 数据表名
FLASK_TASK_TABLE=task
FLASK_USER_TABLE=users


# ============== JavaWeb 项目配置 ==================

# JavaWeb 服务地址
BASE_URL_JAVA=http://127.0.0.1:8080

# JavaWeb 登录账号（每个角色一个代表账号）
# 管理员
JAVA_ADMIN_USERNAME=admin
JAVA_ADMIN_PASSWORD=
# 教师
JAVA_TEACHER_USERNAME=teacher1
JAVA_TEACHER_PASSWORD=
# 学生
JAVA_STUDENT_USERNAME=student1
JAVA_STUDENT_PASSWORD=

# JavaWeb 数据库配置
JAVA_DB_HOST=127.0.0.1
JAVA_DB_PORT=3306
JAVA_DB_NAME=student_management
JAVA_DB_USER=root
JAVA_DB_PASSWORD=
JAVA_DB_CHARSET=utf8mb4

# JavaWeb 数据表名
JAVA_CLASS_TABLE=class
JAVA_SCORE_TABLE=score
JAVA_STUDENT_COURSE_TABLE=student_course